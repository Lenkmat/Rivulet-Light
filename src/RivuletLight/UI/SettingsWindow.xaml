<Window x:Class="RivuletLight.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rivulet Light 设置"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="460"
        Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- Fluent 暗色主题（AccentBrush 代码中替换为系统强调色） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#A62B2B2B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9A9A"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#4A4A4A"/>

        <!-- 分组标题 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="4,16,0,6"/>
        </Style>

        <!-- 设置卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Fluent 滑块：4px 圆角轨道 + 强调色已填充段 + 圆形滑块 -->
        <Style x:Key="WinUISlider" TargetType="Slider">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="2"
                                                            Background="{StaticResource AccentBrush}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="2"
                                                            Background="{StaticResource TrackBrush}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Fill="#F3F3F3"
                                                             Stroke="#33000000" StrokeThickness="1"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent 开关：40×20 圆角轨道 + 12px 滑块 -->
        <Style x:Key="WinUIToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="TrackBorder"
                                    CornerRadius="10"
                                    Background="#2EFFFFFF"
                                    BorderBrush="#5AFFFFFF"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Knob"
                                     Width="12" Height="12"
                                     Fill="#D8D8D8"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrackBorder" Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TrackBorder" Property="BorderBrush"
                                        Value="{x:Null}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#1B1B1B"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TrackBorder" Property="Background" Value="#3DFFFFFF"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Knob" Property="Fill" Value="#000000"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent 分段按钮（替代 ComboBox 的单选组） -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                CornerRadius="3"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="10,4">
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center"
                                              TextBlock.Foreground="#C8C8C8"
                                              TextBlock.FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#454545"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#5A5A5A"/>
                                <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C0C0C0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 窗口主体：圆角边框 + 亚克力毛玻璃由 Acrylic.Enable 实现 -->
    <Border x:Name="RootBorder"
            CornerRadius="8"
            Background="#D8202020"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="OnDragMove">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Height="44" Margin="4,4,4,0">
                <TextBlock Text="设置"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Style="{StaticResource CaptionButton}"
                        Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" Margin="12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,0,4,16">

                    <!-- ══ 通用 ══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="通用"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="效果开关"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="在屏幕底部显示随声音律动的波光"/>
                            </StackPanel>
                            <CheckBox x:Name="EffectToggle" Grid.Column="1"
                                      Style="{StaticResource WinUIToggle}"
                                      VerticalAlignment="Center"
                                      Checked="OnEffectToggleChanged"
                                      Unchecked="OnEffectToggleChanged"/>
                        </Grid>
                    </Border>

                    <!-- ══ 频谱 ══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="频谱"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="频谱数量"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="频段越多，横向过渡越细腻"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="SpectrumBandsValue" Text="96"
                                           Width="30" TextAlignment="Right"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="SpectrumBandsSlider"
                                        Width="150" Margin="10,0,0,0"
                                        Minimum="16" Maximum="96"
                                        TickFrequency="4" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="4" SmallChange="4"
                                        Style="{StaticResource WinUISlider}"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnSpectrumBandsChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="回落强度"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="峰值回落速度，越低越顺滑"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="FallStrengthValue" Text="3"
                                           Width="30" TextAlignment="Right"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="FallStrengthSlider"
                                        Width="150" Margin="10,0,0,0"
                                        Minimum="1" Maximum="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="1" SmallChange="1"
                                        Style="{StaticResource WinUISlider}"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnFallStrengthChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="峰值高度"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="波峰向上延伸的幅度（倍率）"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="PeakHeightValue" Text="1.05"
                                           Width="30" TextAlignment="Right"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="PeakHeightSlider"
                                        Width="150" Margin="10,0,0,0"
                                        Minimum="0.5" Maximum="2.0"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="0.05" SmallChange="0.05"
                                        Style="{StaticResource WinUISlider}"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnPeakHeightChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="覆盖层高度"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="底部效果区域的逻辑像素高度"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="BandHeightValue" Text="260"
                                           Width="30" TextAlignment="Right"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="BandHeightSlider"
                                        Width="150" Margin="10,0,0,0"
                                        Minimum="160" Maximum="320"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="10" SmallChange="10"
                                        Style="{StaticResource WinUISlider}"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnBandHeightChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ 外观 ══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="外观"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="整体强度"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="效果淡入后的整体不透明度"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="IntensityValue" Text="0.80"
                                           Width="30" TextAlignment="Right"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="IntensitySlider"
                                        Width="150" Margin="10,0,0,0"
                                        Minimum="0.1" Maximum="1.0"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="0.05" SmallChange="0.05"
                                        Style="{StaticResource WinUISlider}"
                                        VerticalAlignment="Center"
                                        ValueChanged="OnIntensityChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="颜色模式"/>
                            <TextBlock Style="{StaticResource CardDesc}"
                                       Text="封面取色跟随正在播放的音乐封面；无封面时回退系统主题色"
                                       Margin="0,2,0,8"/>
                            <Border CornerRadius="4" Background="#20FFFFFF"
                                    Padding="2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeCover" GroupName="ColorMode"
                                                 Tag="CoverPalette" Content="封面取色"
                                                 Style="{StaticResource SegRadio}"
                                                 Checked="OnColorModeChecked"/>
                                    <RadioButton x:Name="ModeFixed" GroupName="ColorMode"
                                                 Tag="FixedColor" Content="固定色"
                                                 Style="{StaticResource SegRadio}"
                                                 Margin="2,0"
                                                 Checked="OnColorModeChecked"/>
                                    <RadioButton x:Name="ModeAmbient" GroupName="ColorMode"
                                                 Tag="AmbientAuto" Content="氛围自动"
                                                 Style="{StaticResource SegRadio}"
                                                 Checked="OnColorModeChecked"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel x:Name="ColorSwatches" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ 系统 ══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="系统"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="帧率"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="渲染帧率，60 更流畅、30 更省电"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="4" Background="#20FFFFFF"
                                    Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Fps30" GroupName="FrameRate"
                                                 Tag="30" Content="30"
                                                 Style="{StaticResource SegRadio}"
                                                 Checked="OnFrameRateChecked"/>
                                    <RadioButton x:Name="Fps60" GroupName="FrameRate"
                                                 Tag="60" Content="60"
                                                 Style="{StaticResource SegRadio}"
                                                 Margin="2,0,0,0"
                                                 Checked="OnFrameRateChecked"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="开机自启"/>
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="登录 Windows 后自动运行"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                                      Style="{StaticResource WinUIToggle}"
                                      VerticalAlignment="Center"
                                      Checked="OnAutoStartChanged"
                                      Unchecked="OnAutoStartChanged"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
