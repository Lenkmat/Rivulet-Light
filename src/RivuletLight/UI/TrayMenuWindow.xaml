<Window x:Class="RivuletLight.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RivuletLightMenu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="216"
        Height="154"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- WinUI MenuFlyout 项：30px 高、4px 圆角悬停、图标 + 文本 -->
        <Style x:Key="TrayMenuItem" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MenuText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- 亚克力毛玻璃菜单体（Acrylic.Enable 失焦仍可见） -->
    <Border CornerRadius="8"
            Background="#D8242424"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            Padding="4">
        <StackPanel>
            <Button Style="{StaticResource TrayMenuItem}" Click="OnPauseClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PauseGlyph" Style="{StaticResource MenuGlyph}" Text="&#xE769;"/>
                    <TextBlock x:Name="PauseText" Style="{StaticResource MenuText}" Text="暂停"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TrayMenuItem}" Click="OnSettingsClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE713;"/>
                    <TextBlock Style="{StaticResource MenuText}" Text="设置"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TrayMenuItem}" Click="OnRestartClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE777;"/>
                    <TextBlock Style="{StaticResource MenuText}" Text="重启"/>
                </StackPanel>
            </Button>
            <Border Height="1" Background="#1AFFFFFF" Margin="6,3"/>
            <Button Style="{StaticResource TrayMenuItem}" Click="OnExitClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7E8;"/>
                    <TextBlock Style="{StaticResource MenuText}" Text="退出"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
